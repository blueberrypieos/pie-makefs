Description: A specification's time= keeps the -T change time
 A time= in a specification set a file's change time to the time of the
 run, so a fixed -T no longer gave the same image. With -T, the change
 time is now the -T time. Without it, it is the time of the run, as before.
Author: The Blueberry Pie OS Authors
Forwarded: no
Last-Update: 2026-11-15

--- a/src/freebsd-src/usr.sbin/makefs/walk.c
+++ b/src/freebsd-src/usr.sbin/makefs/walk.c
@@ -36,6 +36,7 @@
  * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
  * POSSIBILITY OF SUCH DAMAGE.
  */
+/* Modified 2026-11-15: with -T, a specification's time= keeps the -T change time. */
 
 #include <sys/param.h>
 #include <sys/stat.h>
@@ -527,11 +528,13 @@
 		    (long)specnode->st_mtimespec.tv_sec);
 		dirnode->inode->st.st_mtime =		specnode->st_mtimespec.tv_sec;
 		dirnode->inode->st.st_atime =		specnode->st_mtimespec.tv_sec;
-		dirnode->inode->st.st_ctime =		start_time.tv_sec;
+		dirnode->inode->st.st_ctime =		stampst.st_ino != 0 ?
+		    stampst.st_ctime : start_time.tv_sec;
 #if HAVE_STRUCT_STAT_ST_MTIMENSEC
 		dirnode->inode->st.st_mtimensec =	specnode->st_mtimespec.tv_nsec;
 		dirnode->inode->st.st_atimensec =	specnode->st_mtimespec.tv_nsec;
-		dirnode->inode->st.st_ctimensec =	start_time.tv_nsec;
+		dirnode->inode->st.st_ctimensec =	stampst.st_ino != 0 ?
+		    stampst.st_ctimensec : start_time.tv_nsec;
 #endif
